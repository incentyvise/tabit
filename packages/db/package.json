{
  "name": "db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "tsc --noEmit",
    "db:generate": "pnpm build && doppler run -- drizzle-kit generate",
    "db:migrate": "doppler run -- drizzle-kit migrate",
    "db:migrate:prod": "doppler run -- drizzle-kit migrate",
    "db:push": "doppler run -- drizzle-kit push",
    "db:studio": "doppler run -- drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "models": "workspace:*",
    "pg": "catalog:",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
